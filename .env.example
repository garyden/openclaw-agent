# Copy to .env.development and fill in development-only credentials.
# Production reads configuration from its service environment.
APP_ENV=development
# Blank selects the checkout-local memory/development.xml in development.
CRM_MEMORY_PATH=
TELEGRAM_BOT_TOKEN=
# Both lists are required; each update must match BOTH. Numeric IDs only.
TELEGRAM_OWNER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional integrations. Use development-only API credentials.
# SMTP is enabled only in production after owner confirmation.
OPENAI_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_CHAT_ID=
DAILY_BRIEF_TIME=08:00
DAILY_BRIEF_TIMEZONE=America/New_York
